# Palavra-passe de acesso a app (obrigatoria quando exposta a internet)
KABLY_PASSWORD=muda-me

# Base de dados.
# - Local (predefinicao): nao definir nada -> usa node:sqlite em data/kably.db
# - Producao (Turso): definir as duas variaveis com os valores do painel Turso
# DATABASE_URL=libsql://o-teu-db.turso.io
# DATABASE_AUTH_TOKEN=eyJ...

# Email (Resend). Sem RESEND_API_KEY, os emails sao registados na consola (dev),
# nao enviados. Para enviar a serio: criar conta em resend.com e por a chave.
# EMAIL_FROM so funciona com dominio verificado; sem isso usa onboarding@resend.dev.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Kably <orcamentos@teu-dominio.pt>
# APP_URL=https://kably-production.up.railway.app   # base dos links nos emails

# Monitorizacao de erros (opcional). Sem isto, erros vao so para os logs.
# SENTRY_DSN=https://xxxx@oYYYY.ingest.sentry.io/ZZZZ
